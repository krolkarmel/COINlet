<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.C0inlet"
        tools:targetApi="31">
        <activity
            android:name=".applock.BiometricSettings"
            android:exported="false" />
        <activity
            android:name=".facelogin.FaceSetupActivity"
            android:exported="false" />
        <activity
            android:name=".faq.FaqItem"
            android:exported="false" />
        <activity
            android:name=".faq.HelpActivity"
            android:exported="false" />
        <activity
            android:name=".faq.ContactActivity"
            android:exported="false" />
        <activity
            android:name=".facelogin.FaceLoginActivity"
            android:exported="false" />
        <activity
            android:name=".facelogin.FaceEnrollActivity"
            android:exported="false" />
        <activity
            android:name=".app.ActivityUserProfile"
            android:exported="false" />
        <activity
            android:name=".applock.LockActivity"
            android:exported="false" />
        <activity
            android:name=".applock.EnterPinActivity"
            android:exported="false" />
        <activity
            android:name=".applock.BiometricSetupActivity"
            android:exported="false" />
        <activity
            android:name=".applock.ConfirmPinActivity"
            android:exported="false" />
        <activity
            android:name=".app.TransferHistory"
            android:exported="false" />
        <activity
            android:name=".app.TransferActivity"
            android:exported="false" />
        <activity
            android:name=".register.SecondStepRegister"
            android:exported="false" />
        <activity
            android:name=".register.ConfirmCodeRegisterStep"
            android:exported="false" />
        <activity
            android:name=".register.IdRegisterStep"
            android:exported="false" />
        <activity
            android:name=".app.Dashboard"
            android:exported="false" />
        <activity
            android:name=".register.FinishRegisterStep"
            android:exported="false" />
        <activity
            android:name=".register.FifthRegisterStep"
            android:exported="false" />
        <activity
            android:name=".register.FourthRegisterStep"
            android:exported="false" />
        <activity
            android:name=".register.ThirdRegisterStep"
            android:exported="false" />
        <activity
            android:name=".register.FirstRegisterStep"
            android:exported="true" />
        <activity
            android:name=".login.Login"
            android:exported="false" />
        <activity
            android:name=".app.SplashScreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>